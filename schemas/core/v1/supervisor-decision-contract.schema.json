{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervisor-decision-contract.schema.json",
  "title": "Sitometron supervisor decision contract v1 (ADR-0012)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_version", "status", "authority", "case_semantics", "seed_provenance", "quotient", "placeholder_allocation", "classes", "vectors", "seeds", "reducer_accepted_but_undeliverable", "runtime_vectors"],
  "properties": {
    "$schema": {"const": "supervisor-decision-contract.schema.json"},
    "contract_version": {"const": 1},
    "status": {"const": "normative"},
    "authority": {"const": "ADR-0012"},
    "case_semantics": {"const": "ordered_first_match"},
    "seed_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["issue", "reconciliation", "adr_context"],
      "properties": {"issue": {"const": 104}, "reconciliation": {"type": "string", "minLength": 1}, "adr_context": {"type": "string", "minLength": 1}}
    },
    "quotient": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "worker_sequence", "timer_generation"],
      "properties": {"identity": {"type": "string"}, "worker_sequence": {"type": "string"}, "timer_generation": {"type": "string"}}
    },
    "placeholder_allocation": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation_id", "schema_id", "schema_version", "payload_utf8", "sha256"],
      "properties": {
        "allocation_id": {"const": "phase1-empty-allocation"},
        "schema_id": {"const": "allocation.v1"}, "schema_version": {"const": 1}, "payload_utf8": {"const": "{}"},
        "sha256": {"const": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"}
      }
    },
    "classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/class"}},
    "vectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vector"}},
    "seeds": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"$ref": "#/$defs/seed"}},
    "reducer_accepted_but_undeliverable": {"type": "array", "items": {"$ref": "#/$defs/undeliverable"}},
    "runtime_vectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "class": {
      "type": "object", "additionalProperties": false, "required": ["id", "snapshot", "witness"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "snapshot": {"$ref": "job-reducer-snapshot.schema.json"}, "witness": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["rule", "kind", "event", "sources", "payload_rule"],
      "properties": {
        "rule": {"type": "integer", "minimum": 1, "maximum": 13},
        "kind": {"enum": ["Submit", "Wait", "Done"]},
        "event": {"enum": ["", "resources_committed", "worker_launch_intent", "session_retain_requested", "finalization_completed", "terminal_outcome_committed", "resources_released", "cleanup_status_recorded"]},
        "sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["application_runner", "worker_protocol", "timer_port", "commands", "session_retainer"]}},
        "payload_rule": {"enum": ["none", "fixed_empty_allocation", "creation_launch_identity_and_committed_allocation", "bound_session", "empty", "latched_reason_or_success_candidate", "bound_allocation", "cleanup_completed"]}
      }
    },
    "vector": {
      "type": "object", "additionalProperties": false, "required": ["id", "class_id", "launch_inputs_present", "expected"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "class_id": {"type": ["string", "null"]}, "launch_inputs_present": {"type": "boolean"}, "expected": {"$ref": "#/$defs/decision"}}
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pair_id", "case_id", "before_class", "after_class", "payload", "provenance"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "pair_id": {"type": "string"}, "case_id": {"type": "string"}, "before_class": {"$ref": "#/$defs/id"}, "after_class": {"$ref": "#/$defs/id"}, "payload": {"type": "object"}, "provenance": {"type": "string", "minLength": 1}}
    },
    "undeliverable": {
      "type": "object", "additionalProperties": false,
      "required": ["class_id", "pair_id", "case_id", "payload", "reason"],
      "properties": {"class_id": {"$ref": "#/$defs/id"}, "pair_id": {"type": "string"}, "case_id": {"type": "string"}, "payload": {"type": "object"}, "reason": {"enum": ["no_producer_deliverable_witness", "no_current_armed_phase_for_this_class", "worker_delivery_identity_conflicts_with_pending"]}}
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "check", "scenario", "parameters", "expectation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "check": {"enum": ["job_supervisor_drives_to_cleanup", "job_supervisor_overtakes", "job_supervisor_rejection_rederives", "job_supervisor_ingress_results", "job_supervisor_no_writer_reentry"]},
        "scenario": {"type": "string", "minLength": 1},
        "parameters": {"type": "object", "additionalProperties": {"type": "string"}},
        "expectation": {"type": "string", "minLength": 1}
      }
    }
  }
}
