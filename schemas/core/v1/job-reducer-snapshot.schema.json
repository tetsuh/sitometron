{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-reducer-snapshot.schema.json",
  "title": "Sitometron core Job reducer snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "session_id",
    "state",
    "latched_reason",
    "completion_candidate",
    "completion_mode",
    "resource_status",
    "allocation_id",
    "allocation_digest",
    "worker_launch_status",
    "launch_operation_id",
    "worker_id",
    "process_presence",
    "process_exit_confirmed",
    "session_retention_status",
    "finalization_status",
    "cleanup_status",
    "pending_worker_event_ack",
    "pending_worker_id",
    "pending_worker_event_sequence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "$ref": "#/$defs/uuidV7"
    },
    "session_id": {
      "$ref": "#/$defs/uuidV7",
      "x-sitometron-equals-field": "job_id"
    },
    "state": {
      "enum": [
        "admitted",
        "preparing",
        "running",
        "stopping",
        "finalizing",
        "succeeded",
        "failed",
        "cancelled",
        "terminated",
        "timed_out"
      ]
    },
    "latched_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "failed",
        "cancelled",
        "terminated",
        "timed_out"
      ]
    },
    "completion_candidate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "succeeded"
      ]
    },
    "completion_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "cooperative",
        "forced",
        "process_already_exited"
      ]
    },
    "resource_status": {
      "enum": [
        "none",
        "committed",
        "released"
      ]
    },
    "allocation_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stableId"
        }
      ]
    },
    "allocation_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "worker_launch_status": {
      "enum": [
        "not_started",
        "intent_recorded",
        "observed",
        "failed"
      ]
    },
    "launch_operation_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stableId"
        }
      ]
    },
    "worker_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/uuidV4"
        }
      ]
    },
    "process_presence": {
      "enum": [
        "absent",
        "unknown",
        "present"
      ]
    },
    "process_exit_confirmed": {
      "type": "boolean"
    },
    "session_retention_status": {
      "enum": [
        "not_started",
        "requested",
        "retained"
      ]
    },
    "finalization_status": {
      "enum": [
        "not_started",
        "pending",
        "completed",
        "failed"
      ]
    },
    "cleanup_status": {
      "enum": [
        "pending",
        "completed",
        "incomplete"
      ]
    },
    "pending_worker_event_ack": {
      "type": "boolean"
    },
    "pending_worker_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/uuidV4"
        }
      ]
    },
    "pending_worker_event_sequence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      ]
    }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resource_status": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "allocation_id": {
            "type": "null"
          },
          "allocation_digest": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_status": {
            "enum": [
              "committed",
              "released"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "allocation_id": {
            "not": {
              "type": "null"
            }
          },
          "allocation_digest": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "process_exit_confirmed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "process_exit_confirmed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "process_presence": {
            "const": "absent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion_mode": {
            "const": "process_already_exited"
          }
        }
      },
      "then": {
        "properties": {
          "process_exit_confirmed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worker_launch_status": {
            "const": "not_started"
          }
        }
      },
      "then": {
        "properties": {
          "launch_operation_id": {
            "type": "null"
          },
          "worker_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worker_launch_status": {
            "enum": [
              "intent_recorded",
              "observed",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "launch_operation_id": {
            "not": {
              "type": "null"
            }
          },
          "worker_id": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pending_worker_event_ack": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "pending_worker_id": {
            "type": "null"
          },
          "pending_worker_event_sequence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pending_worker_event_ack": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "pending_worker_id": {
            "not": {
              "type": "null"
            }
          },
          "pending_worker_event_sequence": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "admitted",
              "preparing",
              "running",
              "stopping"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "finalization_status": {
            "const": "not_started"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "finalizing"
          }
        }
      },
      "then": {
        "properties": {
          "finalization_status": {
            "enum": [
              "pending",
              "completed",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "terminated",
              "timed_out"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "finalization_status": {
            "enum": [
              "completed",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "resource_status": {
            "const": "none"
          },
          "worker_launch_status": {
            "const": "not_started"
          },
          "process_presence": {
            "const": "absent"
          },
          "process_exit_confirmed": {
            "const": false
          }
        }
      }
    }
  ]
}
