cmake_minimum_required(VERSION 3.28)

if(DEFINED SITOMETRON_HTTP_PUBLIC_SCAN_FILES)
  set(_files ${SITOMETRON_HTTP_PUBLIC_SCAN_FILES})
else()
  file(GLOB_RECURSE _files
    "${CMAKE_CURRENT_LIST_DIR}/../include/sitometron/http/*.hpp")
endif()

foreach(_file IN LISTS _files)
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "HttpPublicApiIsolation setup failure: missing scan file ${_file}")
  endif()
  file(READ "${_file}" _contents)
  string(ASCII 239 187 191 _utf8_bom)
  string(LENGTH "${_contents}" _contents_length)
  if(_contents_length GREATER_EQUAL 3)
    string(SUBSTRING "${_contents}" 0 3 _contents_prefix)
    if("${_contents_prefix}" STREQUAL "${_utf8_bom}")
      string(SUBSTRING "${_contents}" 3 -1 _contents)
    endif()
  endif()
  string(REPLACE "\r\n" "\n" _contents "${_contents}")
  string(REPLACE "\r" "\n" _contents "${_contents}")
  set(_line_number 0)
  while(TRUE)
    string(FIND "${_contents}" "\n" _newline_index)
    if(_newline_index EQUAL -1)
      set(_line "${_contents}")
      set(_contents "")
      set(_has_next_line FALSE)
    else()
      string(SUBSTRING "${_contents}" 0 ${_newline_index} _line)
      math(EXPR _next_line_start "${_newline_index} + 1")
      string(SUBSTRING "${_contents}" ${_next_line_start} -1 _contents)
      set(_has_next_line TRUE)
    endif()
    math(EXPR _line_number "${_line_number} + 1")
    if("${_line}" MATCHES [[^[ 	]*#[ 	]*include]])
      if("${_line}" MATCHES [[^[ 	]*#[ 	]*include[ 	]*<([^>]+)>[ 	]*(//.*)?$]])
        set(_header_name "${CMAKE_MATCH_1}")
      elseif("${_line}" MATCHES [[^[ 	]*#[ 	]*include[ 	]*"([^"]+)"[ 	]*(//.*)?$]])
        set(_header_name "${CMAKE_MATCH_1}")
      else()
        message(FATAL_ERROR
          "HttpPublicApiIsolation unparseable HTTP public include directive: "
          "${_file}:${_line_number}: ${_line}")
      endif()
      if(_header_name MATCHES "^(boost/|nlohmann/)")
        message(FATAL_ERROR
          "HttpPublicApiIsolation dependency-owned public include: "
          "${_file}:${_line_number}: ${_line}")
      endif()
    endif()
    if(NOT _has_next_line)
      break()
    endif()
  endwhile()
  file(READ "${_file}" _contents)
  string(LENGTH "${_contents}" _contents_length)
  if(_contents_length GREATER_EQUAL 3)
    string(SUBSTRING "${_contents}" 0 3 _contents_prefix)
    if("${_contents_prefix}" STREQUAL "${_utf8_bom}")
      string(SUBSTRING "${_contents}" 3 -1 _contents)
    endif()
  endif()
  string(REPLACE "\r\n" "\n" _contents "${_contents}")
  string(REPLACE "\r" "\n" _contents "${_contents}")
  set(_line_number 0)
  while(TRUE)
    string(FIND "${_contents}" "\n" _newline_index)
    if(_newline_index EQUAL -1)
      set(_line "${_contents}")
      set(_contents "")
      set(_has_next_line FALSE)
    else()
      string(SUBSTRING "${_contents}" 0 ${_newline_index} _line)
      math(EXPR _next_line_start "${_newline_index} + 1")
      string(SUBSTRING "${_contents}" ${_next_line_start} -1 _contents)
      set(_has_next_line TRUE)
    endif()
    math(EXPR _line_number "${_line_number} + 1")
    if("${_line}" MATCHES [[(^|[^A-Za-z0-9_])(boost|nlohmann)([^A-Za-z0-9_]|$)]])
      message(FATAL_ERROR
        "HttpPublicApiIsolation dependency root word: "
        "${_file}:${_line_number}: ${_line}")
    endif()
    if(NOT _has_next_line)
      break()
    endif()
  endwhile()
  file(READ "${_file}" _contents)
  if(_contents MATCHES "(^|[^A-Za-z0-9_])(boost::|beast::|asio::|nlohmann::)")
    message(FATAL_ERROR
      "HttpPublicApiIsolation dependency-owned public type: ${_file}")
  endif()
endforeach()

message(STATUS "HttpPublicApiIsolation public header boundary passed")
