cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/check_registry_scan_lines.cmake")
if(DEFINED SITOMETRON_REGISTRY_SCAN_CONFIG)
  include("${SITOMETRON_REGISTRY_SCAN_CONFIG}")
endif()
if(NOT SITOMETRON_REGISTRY_LINK_TARGETS OR NOT SITOMETRON_REGISTRY_SCAN_FILES)
  message(FATAL_ERROR "RegistryDependencyAllowlist requires targets and scan files")
endif()
set(_registry_expected_targets nlohmann_json::nlohmann_json Boost::hash2)
function(registry_require_targets _label _private)
  set(_actual)
  string(REPLACE "," ";" _targets "${ARGN}")
  foreach(_target IN LISTS _targets)
    set(_candidate "${_target}")
    if(_private)
      if(NOT _target MATCHES "^\\$<LINK_ONLY:(.*)>$")
        message(FATAL_ERROR "RegistryDependencyAllowlist public dependency leakage: ${_target}")
      endif()
      set(_candidate "${CMAKE_MATCH_1}")
    endif()
    if(NOT _candidate IN_LIST _registry_expected_targets)
      message(FATAL_ERROR "RegistryDependencyAllowlist unapproved registry link target: ${_target}")
    endif()
    list(APPEND _actual "${_candidate}")
  endforeach()
  list(SORT _actual)
  set(_expected ${_registry_expected_targets})
  list(SORT _expected)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "RegistryDependencyAllowlist exact target set mismatch in ${_label}")
  endif()
endfunction()
registry_require_targets(LINK_LIBRARIES FALSE ${SITOMETRON_REGISTRY_LINK_TARGETS})
if(DEFINED SITOMETRON_REGISTRY_INTERFACE_LINK_TARGETS)
  registry_require_targets(INTERFACE_LINK_LIBRARIES TRUE ${SITOMETRON_REGISTRY_INTERFACE_LINK_TARGETS})
endif()

# Reviewed direct standard headers; upstream transitive headers grant no additional direct use.
set(_registry_standard_headers algorithm array cstddef filesystem fstream initializer_list
  optional set string string_view system_error utility variant vector)
set(_registry_dependency_headers nlohmann/json.hpp boost/hash2/sha2.hpp)
function(registry_check_include _file _number _line)
  if(NOT "${_line}" MATCHES [[^[ 	]*#[ 	]*include]])
    return()
  endif()
  registry_parse_include(RegistryDependencyAllowlist "${_file}" "${_number}" "${_line}")
  if(REGISTRY_HEADER IN_LIST _registry_standard_headers OR
     REGISTRY_HEADER IN_LIST _registry_dependency_headers OR
     REGISTRY_HEADER STREQUAL "registry_validation.hpp")
    return()
  endif()
  if(REGISTRY_HEADER MATCHES "^sitometron/registry/[A-Za-z0-9_./-]+$" AND
     NOT REGISTRY_HEADER MATCHES "(^|/)\\.\\.(/|$)")
    return()
  endif()
  message(FATAL_ERROR "RegistryDependencyAllowlist unapproved registry include: ${_file}:${_number}: ${_line}")
endfunction()
foreach(_file IN LISTS SITOMETRON_REGISTRY_SCAN_FILES)
  registry_scan_lines("${_file}" registry_check_include)
endforeach()
message(STATUS "RegistryDependencyAllowlist exact private targets and direct includes passed")
