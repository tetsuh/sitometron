function(read_string_array json output)
  set(path ${ARGN})
  string(JSON length LENGTH "${json}" ${path})
  set(values "")
  if(length GREATER 0)
    math(EXPR last "${length} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON value GET "${json}" ${path} ${index})
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(read_event_definition_refs schema output)
  string(JSON count LENGTH "${schema}" oneOf)
  math(EXPR last "${count} - 1")
  set(values "")
  foreach(index RANGE 0 ${last})
    string(JSON reference GET "${schema}" oneOf ${index} "$ref")
    if(NOT reference MATCHES "^job-journal-event.schema.json#/[$]defs/[A-Za-z][A-Za-z0-9]*$")
      message(FATAL_ERROR "Event schema has an unexpected reference: ${reference}")
    endif()
    string(REGEX REPLACE "^.*/" "" definition "${reference}")
    list(APPEND values "${definition}")
  endforeach()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(assert_unique values label)
  set(original ${values})
  set(unique ${values})
  list(REMOVE_DUPLICATES unique)
  list(LENGTH original original_length)
  list(LENGTH unique unique_length)
  if(NOT original_length EQUAL unique_length)
    message(FATAL_ERROR "${label} contains duplicate values")
  endif()
endfunction()

function(json_signature json output)
  set(path ${ARGN})
  string(JSON type ERROR_VARIABLE error TYPE "${json}" ${path})
  if(NOT error STREQUAL "NOTFOUND")
    set(${output} "MISSING" PARENT_SCOPE)
    return()
  endif()
  if(type STREQUAL "NULL")
    set(signature "NULL")
  else()
    string(JSON value GET "${json}" ${path})
    set(signature "${type}:${value}")
  endif()
  set(${output} "${signature}" PARENT_SCOPE)
endfunction()

