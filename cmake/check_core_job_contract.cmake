# Validate candidate payload fields and the scalar/nested constraints used by every core fixture.
function(validate_event_payload event payload label expect_valid)
  set(def_key "EVENT_DEF_${event}")
  if(NOT DEFINED ${def_key})
    message(FATAL_ERROR "${label}: unknown event type ${event}")
  endif()
  set(def_name "${${def_key}}")
  string(JSON payload_schema GET "${journal_schema}" "$defs" "${def_name}" properties payload)
  string(JSON payload_ref ERROR_VARIABLE payload_ref_error GET "${payload_schema}" "$ref")
  if(payload_ref_error STREQUAL "NOTFOUND")
    string(REPLACE "#/$defs/" "" payload_def_name "${payload_ref}")
    string(JSON payload_schema GET "${journal_schema}" "$defs" "${payload_def_name}")
  endif()
  string(JSON allowed_count ERROR_VARIABLE allowed_error LENGTH "${payload_schema}" properties)
  if(NOT allowed_error STREQUAL "NOTFOUND")
    set(allowed_count 0)
  endif()
  set(allowed "")
  if(allowed_count GREATER 0)
    math(EXPR allowed_last "${allowed_count} - 1")
    foreach(index RANGE 0 ${allowed_last})
      string(JSON member MEMBER "${payload_schema}" properties ${index})
      list(APPEND allowed "${member}")
    endforeach()
  endif()
  string(JSON required_count ERROR_VARIABLE required_error LENGTH "${payload_schema}" required)
  set(valid TRUE)
  if(required_error STREQUAL "NOTFOUND" AND required_count GREATER 0)
    math(EXPR required_last "${required_count} - 1")
    foreach(index RANGE 0 ${required_last})
      string(JSON member GET "${payload_schema}" required ${index})
      string(JSON ignored ERROR_VARIABLE member_error TYPE "${payload}" "${member}")
      if(NOT member_error STREQUAL "NOTFOUND")
        set(valid FALSE)
      endif()
    endforeach()
  endif()
  string(JSON payload_count LENGTH "${payload}")
  if(payload_count GREATER 0)
    math(EXPR payload_last "${payload_count} - 1")
    foreach(index RANGE 0 ${payload_last})
      string(JSON member MEMBER "${payload}" ${index})
      list(FIND allowed "${member}" member_index)
      if(member_index EQUAL -1)
        set(valid FALSE)
      endif()
    endforeach()
  endif()
  if(valid)
    if(event STREQUAL "job_created" OR event MATCHES "^session_retain")
      string(JSON value GET "${payload}" session_id)
      is_uuid_v7("${value}" scalar_valid)
      if(NOT scalar_valid)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "resources_committed")
      string(JSON allocation_id GET "${payload}" allocation_id)
      string(JSON allocation_digest GET "${payload}" allocation_digest)
      string(JSON schema_id GET "${payload}" resolved_allocation schema_id)
      string(JSON schema_version GET "${payload}" resolved_allocation schema_version)
      string(JSON payload_utf8 GET "${payload}" resolved_allocation payload_utf8)
      is_sha256("${allocation_digest}" digest_valid)
      string(SHA256 computed_digest "${payload_utf8}")
      string(LENGTH "${payload_utf8}" payload_byte_length)
      string(JSON ignored ERROR_VARIABLE payload_json_error TYPE "${payload_utf8}")
      if(NOT allocation_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR
         NOT schema_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR schema_version LESS 1 OR
         payload_byte_length GREATER 65536 OR NOT payload_json_error STREQUAL "NOTFOUND" OR
         NOT digest_valid OR NOT computed_digest STREQUAL allocation_digest)
        set(valid FALSE)
      endif()
      string(JSON nested_count LENGTH "${payload}" resolved_allocation)
      if(NOT nested_count EQUAL 3)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "worker_launch_intent")
      string(JSON operation_id GET "${payload}" operation_id)
      string(JSON allocation_id GET "${payload}" allocation_id)
      string(JSON allocation_digest GET "${payload}" allocation_digest)
      string(JSON worker_id GET "${payload}" worker_id)
      string(JSON application_id GET "${payload}" application application_id)
      string(JSON application_version GET "${payload}" application version)
      string(JSON bundle_digest GET "${payload}" application bundle_sha256)
      is_uuid_v4("${worker_id}" worker_valid)
      is_sha256("${allocation_digest}" allocation_digest_valid)
      is_sha256("${bundle_digest}" bundle_digest_valid)
      string(JSON application_count LENGTH "${payload}" application)
      if(NOT operation_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR
         NOT allocation_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR
         NOT application_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR
         application_version STREQUAL "" OR NOT worker_valid OR NOT allocation_digest_valid OR
         NOT bundle_digest_valid OR NOT application_count EQUAL 3)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "worker_launch_observed")
      string(JSON operation_id GET "${payload}" operation_id)
      string(JSON outcome GET "${payload}" outcome)
      if(NOT operation_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR
         NOT outcome MATCHES "^(started|failed)$")
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "worker_running")
      string(JSON worker_id GET "${payload}" worker_id)
      is_uuid_v4("${worker_id}" valid)
    elseif(event MATCHES "^worker_(completed|failed)$")
      string(JSON worker_id GET "${payload}" worker_id)
      string(JSON sequence GET "${payload}" event_sequence)
      is_uuid_v4("${worker_id}" worker_valid)
      is_uint64_nonzero("${sequence}" sequence_valid)
      if(NOT worker_valid OR NOT sequence_valid)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "cancel_accepted" OR event STREQUAL "terminate_accepted")
      string(JSON principal GET "${payload}" principal_subject)
      string(LENGTH "${principal}" principal_length)
      if(principal_length LESS 1 OR principal_length GREATER 256)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "timeout_expired")
      string(JSON phase GET "${payload}" phase)
      string(JSON generation GET "${payload}" timer_generation)
      list(FIND timeout_phases "${phase}" phase_index)
      is_uint64_nonzero("${generation}" generation_valid)
      if(phase_index EQUAL -1 OR NOT generation_valid)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "process_exit_confirmed")
      string(JSON mode GET "${payload}" completion_mode)
      string(JSON operation_id GET "${payload}" launch_operation_id)
      if(NOT mode MATCHES "^(cooperative|forced|process_already_exited)$" OR
         NOT operation_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$")
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "terminal_outcome_committed")
      string(JSON outcome GET "${payload}" outcome)
      list(FIND terminal_outcomes "${outcome}" outcome_index)
      if(outcome_index EQUAL -1)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "resources_released")
      string(JSON allocation_id GET "${payload}" allocation_id)
      string(JSON allocation_digest GET "${payload}" allocation_digest)
      is_sha256("${allocation_digest}" digest_valid)
      if(NOT allocation_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._:-]*$" OR NOT digest_valid)
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "cleanup_status_recorded")
      string(JSON status GET "${payload}" status)
      if(NOT status MATCHES "^(completed|incomplete)$")
        set(valid FALSE)
      endif()
    elseif(event STREQUAL "late_worker_event")
      string(JSON original GET "${payload}" original_event_type)
      string(JSON worker_id GET "${payload}" worker_id)
      string(JSON sequence GET "${payload}" event_sequence)
      is_uuid_v4("${worker_id}" worker_valid)
      is_uint64_nonzero("${sequence}" sequence_valid)
      if(NOT original MATCHES "^worker_(completed|failed)$" OR NOT worker_valid OR
         NOT sequence_valid)
        set(valid FALSE)
      endif()
    endif()
  endif()
  if(expect_valid AND NOT valid)
    message(FATAL_ERROR "${label}: payload violates its strict event schema constraints")
  elseif(NOT expect_valid AND valid)
    message(FATAL_ERROR "${label}: invalid-payload fixture is unexpectedly valid")
  endif()
endfunction()

