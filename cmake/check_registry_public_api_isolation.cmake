cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/check_registry_scan_lines.cmake")
if(DEFINED SITOMETRON_REGISTRY_SCAN_CONFIG)
  include("${SITOMETRON_REGISTRY_SCAN_CONFIG}")
endif()
if(NOT SITOMETRON_REGISTRY_PUBLIC_SCAN_FILES)
  message(FATAL_ERROR "RegistryPublicApiIsolation requires public scan files")
endif()
function(registry_check_public _file _number _line)
  if("${_line}" MATCHES [[^[ 	]*#[ 	]*include]])
    registry_parse_include(RegistryPublicApiIsolation "${_file}" "${_number}" "${_line}")
    if(REGISTRY_HEADER MATCHES "^(boost/|nlohmann/)")
      message(FATAL_ERROR "RegistryPublicApiIsolation dependency-owned public include: ${_file}:${_number}: ${_line}")
    endif()
  endif()
  if("${_line}" MATCHES [[(^|[^A-Za-z0-9_])(boost|nlohmann)([^A-Za-z0-9_]|$)]])
    message(FATAL_ERROR "RegistryPublicApiIsolation dependency root word: ${_file}:${_number}: ${_line}")
  endif()
endfunction()
foreach(_file IN LISTS SITOMETRON_REGISTRY_PUBLIC_SCAN_FILES)
  registry_scan_lines("${_file}" registry_check_public)
endforeach()
message(STATUS "RegistryPublicApiIsolation owned public type boundary passed")
