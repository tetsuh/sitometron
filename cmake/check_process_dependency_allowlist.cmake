cmake_minimum_required(VERSION 3.28)
# Process-only conservative comment/literal lexer; older scanners stay unchanged.
include("${CMAKE_CURRENT_LIST_DIR}/check_process_scan_lines.cmake")
if(DEFINED SITOMETRON_PROCESS_SCAN_CONFIG)
  include("${SITOMETRON_PROCESS_SCAN_CONFIG}")
endif()
if(NOT SITOMETRON_PROCESS_LINK_TARGETS OR NOT SITOMETRON_PROCESS_SCAN_FILES)
  message(FATAL_ERROR "ProcessDependencyAllowlist requires target and source inventories")
endif()
function(process_require_targets _label _interface)
  string(REPLACE "," ";" _targets "${ARGN}")
  set(_actual)
  foreach(_target IN LISTS _targets)
    set(_candidate "${_target}")
    if(_interface)
      if(NOT _target MATCHES "^\\$<LINK_ONLY:(.*)>$")
        message(FATAL_ERROR "ProcessDependencyAllowlist public dependency leakage: ${_target}")
      endif()
      set(_candidate "${CMAKE_MATCH_1}")
    endif()
    if(NOT _candidate STREQUAL "Threads::Threads")
      message(FATAL_ERROR "ProcessDependencyAllowlist unapproved process link target: ${_target}")
    endif()
    list(APPEND _actual "${_candidate}")
  endforeach()
  if(NOT _actual STREQUAL "Threads::Threads")
    message(FATAL_ERROR "ProcessDependencyAllowlist exact private target set mismatch: ${_label}")
  endif()
endfunction()
process_require_targets(LINK_LIBRARIES FALSE ${SITOMETRON_PROCESS_LINK_TARGETS})
if(DEFINED SITOMETRON_PROCESS_INTERFACE_LINK_TARGETS)
  process_require_targets(INTERFACE_LINK_LIBRARIES TRUE ${SITOMETRON_PROCESS_INTERFACE_LINK_TARGETS})
endif()
# Reviewed direct standard headers; no transitive include authorizations.
set(_process_standard_headers algorithm array atomic cassert cerrno condition_variable cstddef
  cstdint iostream limits memory mutex optional stdexcept string string_view thread type_traits
  utility vector)
set(_process_owned_headers handoff_probe.hpp platform.hpp runner_internal.hpp windows_command_line.hpp
  sitometron/core/job_ports.hpp sitometron/core/job_reducer.hpp sitometron/process/runner.hpp)
function(process_check_include _file _number _line _code)
  string(REPLACE "%:" "#" _line "${_line}")
  string(REPLACE "%:" "#" _code "${_code}")
  if(NOT "${_code}" MATCHES [[^[ 	]*#[ 	]*include]])
    return()
  endif()
  registry_parse_include(ProcessDependencyAllowlist "${_file}" "${_number}" "${_line}")
  if(REGISTRY_HEADER IN_LIST _process_standard_headers OR
     REGISTRY_HEADER IN_LIST _process_owned_headers)
    return()
  endif()
  get_filename_component(_name "${_file}" NAME)
  if(_name STREQUAL "platform_linux.cpp" AND
     REGISTRY_HEADER MATCHES "^(spawn[.]h|signal[.]h|sys/wait[.]h)$")
    return()
  endif()
  if(_name STREQUAL "platform_windows.cpp" AND REGISTRY_HEADER STREQUAL "windows.h")
    return()
  endif()
  message(FATAL_ERROR "ProcessDependencyAllowlist unapproved process include: ${_file}:${_number}: ${_line}")
endfunction()
foreach(_file IN LISTS SITOMETRON_PROCESS_SCAN_FILES)
  process_scan_lines("${_file}" process_check_include)
endforeach()
message(STATUS "ProcessDependencyAllowlist exact private targets and direct includes passed")
