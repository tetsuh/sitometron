cmake_minimum_required(VERSION 3.28)
include_guard(GLOBAL)

function(identity_scan_lines _file _handler)
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "IdentityScanner setup failure: missing scan file ${_file}")
  endif()
  file(READ "${_file}" _contents)
  string(ASCII 239 187 191 _bom)
  string(LENGTH "${_contents}" _length)
  if(_length GREATER_EQUAL 3)
    string(SUBSTRING "${_contents}" 0 3 _prefix)
    if("${_prefix}" STREQUAL "${_bom}")
      string(SUBSTRING "${_contents}" 3 -1 _contents)
    endif()
  endif()
  string(REPLACE "\r\n" "\n" _contents "${_contents}")
  string(REPLACE "\r" "\n" _contents "${_contents}")
  set(_line_number 0)
  while(TRUE)
    string(FIND "${_contents}" "\n" _newline)
    if(_newline EQUAL -1)
      set(_line "${_contents}")
      set(_more FALSE)
    else()
      string(SUBSTRING "${_contents}" 0 ${_newline} _line)
      math(EXPR _next "${_newline} + 1")
      string(SUBSTRING "${_contents}" ${_next} -1 _contents)
      set(_more TRUE)
    endif()
    math(EXPR _line_number "${_line_number} + 1")
    cmake_language(CALL "${_handler}" "${_file}" "${_line_number}" "${_line}")
    if(NOT _more)
      break()
    endif()
  endwhile()
endfunction()

function(identity_parse_include _label _file _number _line)
  if("${_line}" MATCHES [[^[ 	]*#[ 	]*include[ 	]*<([^>]+)>[ 	]*(//.*)?$]])
    set(IDENTITY_HEADER "${CMAKE_MATCH_1}" PARENT_SCOPE)
  elseif("${_line}" MATCHES [[^[ 	]*#[ 	]*include[ 	]*"([^"]+)"[ 	]*(//.*)?$]])
    set(IDENTITY_HEADER "${CMAKE_MATCH_1}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR
      "${_label} unparseable identity include directive: ${_file}:${_number}: ${_line}")
  endif()
endfunction()
