cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/check_process_scan_lines.cmake")
if(DEFINED SITOMETRON_PROCESS_SCAN_CONFIG)
  include("${SITOMETRON_PROCESS_SCAN_CONFIG}")
endif()
if(NOT SITOMETRON_PROCESS_PUBLIC_SCAN_FILES)
  message(FATAL_ERROR "ProcessPublicApiIsolation requires public headers")
endif()
set(_process_public_headers array cstddef memory optional string string_view vector
  sitometron/core/job_ports.hpp sitometron/core/job_reducer.hpp sitometron/process/runner.hpp)
set(_process_public_forbidden_types boost nlohmann HANDLE DWORD pid_t PROCESS_INFORMATION STARTUPINFOW)
function(process_check_public _file _number _line _code)
  string(REPLACE "%:" "#" _line "${_line}")
  string(REPLACE "%:" "#" _code "${_code}")
  if("${_code}" MATCHES [[^[ 	]*#[ 	]*include]])
    registry_parse_include(ProcessPublicApiIsolation "${_file}" "${_number}" "${_line}")
    if(NOT REGISTRY_HEADER IN_LIST _process_public_headers)
      message(FATAL_ERROR "ProcessPublicApiIsolation unapproved public include: ${_file}:${_number}: ${_line}")
    endif()
  endif()
  process_scan_identifiers(_words "${_code}")
  foreach(_word IN LISTS _words)
    if(_word IN_LIST _process_public_forbidden_types)
      message(FATAL_ERROR "ProcessPublicApiIsolation dependency/platform public type: ${_file}:${_number}: ${_line}")
    endif()
  endforeach()
endfunction()
foreach(_file IN LISTS SITOMETRON_PROCESS_PUBLIC_SCAN_FILES)
  process_scan_lines("${_file}" process_check_public)
endforeach()
message(STATUS "ProcessPublicApiIsolation owned public type boundary passed")
