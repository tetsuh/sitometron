cmake_minimum_required(VERSION 3.28)
include_guard(GLOBAL)
# Process-only conservative lexer. Older adapter scanners are intentionally unchanged.
include("${CMAKE_CURRENT_LIST_DIR}/check_registry_scan_lines.cmake")

# Include non-ASCII source bytes in identifier tokens. The compiler, not this
# scanner, validates which Unicode code points may appear in an identifier.
string(ASCII 128 _process_high_first)
string(ASCII 255 _process_high_last)
set(_process_identifier_byte "[A-Za-z0-9_$${_process_high_first}-${_process_high_last}]")

function(process_scan_identifiers _out _text)
  string(REGEX MATCHALL "${_process_identifier_byte}+" _words "${_text}")
  set(${_out} "${_words}" PARENT_SCOPE)
endfunction()

macro(process_check_cpp_line)
  string(REPLACE "%:" "#" _cpp "${_code}")
  process_scan_identifiers(_cpp_words "${_cpp}")
  # Issue #141 owner decision (2026-11-22): ban whole words, not just
  # declarations. No macro expansion or conditional selection is needed.
  if("import" IN_LIST _cpp_words OR "module" IN_LIST _cpp_words)
    message(FATAL_ERROR "ProcessScanner forbidden import/module word: ${_file}:${_number}:")
  endif()
  if(_Pragma IN_LIST _cpp_words OR __pragma IN_LIST _cpp_words OR asm IN_LIST _cpp_words OR
      __asm IN_LIST _cpp_words OR __asm__ IN_LIST _cpp_words OR
      "${_cpp}" MATCHES [[^ *# *(pragma|embed)([^A-Za-z0-9_]|$)]])
    message(FATAL_ERROR "ProcessScanner forbidden preprocessing entry point: ${_file}:${_number}:")
  endif()
  if(_directive)
    if("${_cpp}" MATCHES [[^ *# *([A-Za-z_][A-Za-z0-9_]*)]])
      set(_directive_name "${CMAKE_MATCH_1}")
      if(NOT _directive_name IN_LIST _cpp_directives)
        message(FATAL_ERROR "ProcessScanner unsupported directive: ${_file}:${_number}:")
      endif()
    endif()
    if("${_cpp}" MATCHES [[^ *# *define +[A-Za-z_$][A-Za-z0-9_$]*]])
      if("${_cpp}" MATCHES "[^ -~]" OR
          "${_cpp}" MATCHES [[^ *# *define +[A-Za-z_$][A-Za-z0-9_$]*\(]])
        message(FATAL_ERROR "ProcessScanner unsupported macro definition: ${_file}:${_number}:")
      endif()
    elseif("${_cpp}" MATCHES [[^ *# *define([^A-Za-z0-9_]|$)]])
      message(FATAL_ERROR "ProcessScanner unsupported macro name: ${_file}:${_number}:")
    endif()
  endif()
endmacro()

macro(process_finish_scan_line)
  # Bracket arguments do not expand CMake escapes. Recognize only normalized
  # masked text; the callback's raw include line still contains original tabs.
  string(REPLACE "\t" " " _code "${_code}")
  # Token pasting can synthesize an import keyword after lexical recognition.
  string(REPLACE "%:" "#" _tokens "${_code}")
  if("${_tokens}" MATCHES "##")
    message(FATAL_ERROR "ProcessScanner forbidden token paste: ${_file}:${_number}:")
  endif()
  process_check_cpp_line()
  cmake_language(CALL "${_handler}" "${_file}" "${_number}" "${_line}" "${_code}")
  set(_line "")
  set(_code "")
  set(_identifier "")
  set(_directive FALSE)
  set(_block_on_line FALSE)
  if(_state STREQUAL "block")
    set(_block_on_line TRUE)
  elseif(_state STREQUAL "line")
    set(_state normal)
  elseif(_state STREQUAL "quoted")
    message(FATAL_ERROR "ProcessScanner unterminated literal: ${_file}:${_number}:")
  endif()
  math(EXPR _number "${_number} + 1")
endmacro()

function(process_scan_lines _file _handler)
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "ProcessScanner missing scan file ${_file}")
  endif()
  file(READ "${_file}" _contents)
  string(ASCII 239 187 191 _bom)
  string(LENGTH "${_contents}" _length)
  if(_length GREATER_EQUAL 3)
    string(SUBSTRING "${_contents}" 0 3 _prefix)
    if("${_prefix}" STREQUAL "${_bom}")
      string(SUBSTRING "${_contents}" 3 -1 _contents)
    endif()
  endif()
  string(REPLACE "\r\n" "\n" _contents "${_contents}")
  string(REPLACE "\r" "\n" _contents "${_contents}")
  # Phase 2 precedes comments/literals. Refuse, rather than accept, all splices;
  # also reject the trailing-space extension accepted by common C++20 compilers.
  string(ASCII 11 _vertical_tab)
  string(ASCII 12 _form_feed)
  set(_remaining "${_contents}")
  set(_number 1)
  while(TRUE)
    string(FIND "${_remaining}" "\n" _newline)
    if(_newline EQUAL -1)
      break()
    endif()
    string(SUBSTRING "${_remaining}" 0 ${_newline} _physical)
    string(REPLACE "${_vertical_tab}" " " _physical "${_physical}")
    string(REPLACE "${_form_feed}" " " _physical "${_physical}")
    if("${_physical}" MATCHES "\\\\[ \t]*$")
      message(FATAL_ERROR "ProcessScanner forbidden line continuation: ${_file}:${_number}:")
    endif()
    math(EXPR _next "${_newline} + 1")
    string(SUBSTRING "${_remaining}" ${_next} -1 _remaining)
    math(EXPR _number "${_number} + 1")
  endwhile()

  set(_cpp_directives include define undef if ifdef ifndef elif else endif line error warning)
  set(_state normal)
  set(_number 1)
  set(_line "")
  set(_code "")
  set(_identifier "")
  set(_directive FALSE)
  set(_block_on_line FALSE)
  set(_index 0)
  string(LENGTH "${_contents}" _length)
  while(_index LESS _length)
    string(SUBSTRING "${_contents}" ${_index} 1 _char)
    math(EXPR _next "${_index} + 1")
    set(_pair "${_char}")
    if(_next LESS _length)
      string(SUBSTRING "${_contents}" ${_index} 2 _pair)
    endif()
    if("${_char}" STREQUAL "\n")
      process_finish_scan_line()
      set(_index ${_next})
      continue()
    endif()
    string(APPEND _line "${_char}")
    if(_state STREQUAL "raw")
      math(EXPR _available "${_length} - ${_index}")
      if(_available GREATER_EQUAL _raw_length)
        string(SUBSTRING "${_contents}" ${_index} ${_raw_length} _candidate)
        if("${_candidate}" STREQUAL "${_raw_end}")
          math(EXPR _tail "${_raw_length} - 1")
          string(SUBSTRING "${_contents}" ${_next} ${_tail} _suffix)
          string(APPEND _line "${_suffix}")
          math(EXPR _next "${_index} + ${_raw_length}")
          set(_state normal)
          set(_identifier literal_suffix)
        endif()
      endif()
      string(APPEND _code " ")
    elseif(_state STREQUAL "quoted")
      string(APPEND _code " ")
      if("${_char}" STREQUAL "\\" AND _next LESS _length)
        string(SUBSTRING "${_contents}" ${_next} 1 _escaped)
        string(APPEND _line "${_escaped}")
        math(EXPR _next "${_next} + 1")
      elseif("${_char}" STREQUAL "${_quote}")
        set(_state normal)
        set(_identifier literal_suffix)
      endif()
    elseif(_state STREQUAL "block")
      string(APPEND _code " ")
      if("${_pair}" STREQUAL "*/")
        string(APPEND _line "/")
        math(EXPR _next "${_index} + 2")
        set(_state normal)
      endif()
    elseif(_state STREQUAL "line")
      string(APPEND _code " ")
    elseif("${_pair}" STREQUAL "/*")
      if(_directive)
        message(FATAL_ERROR "ProcessScanner comment-adjacent directive: ${_file}:${_number}:")
      endif()
      set(_block_on_line TRUE)
      set(_state block)
      set(_identifier "")
      set(_literal_line ${_number})
      string(APPEND _line "*")
      string(APPEND _code " ")
      math(EXPR _next "${_index} + 2")
    elseif("${_pair}" STREQUAL "//")
      # A line comment cannot bridge a newline. Trailing comments stay permitted.
      if(_directive AND "${_code}" MATCHES "^[ \t]*(#|%:)[ \t]*$")
        message(FATAL_ERROR "ProcessScanner comment before directive name: ${_file}:${_number}:")
      endif()
      set(_state line)
      string(APPEND _line "/")
      string(APPEND _code " ")
      math(EXPR _next "${_index} + 2")
    elseif("${_identifier}" STREQUAL "" AND ("${_char}" MATCHES "^[0-9]$" OR "${_pair}" MATCHES "^[.][0-9]$"))
      # Phase-3 pp-number: consume apostrophes followed by identifier/digit
      # bytes and signs after e/E/p/P, including hexadecimal and UDL suffixes.
      string(SUBSTRING "${_contents}" ${_index} -1 _rest)
      string(REGEX MATCH "^([0-9]|[.][0-9])([eEpP][+-]|'${_process_identifier_byte}|${_process_identifier_byte}|[.])*" _pp_number "${_rest}")
      string(LENGTH "${_pp_number}" _width)
      math(EXPR _tail "${_width} - 1")
      string(SUBSTRING "${_pp_number}" 1 ${_tail} _suffix)
      string(APPEND _line "${_suffix}")
      string(APPEND _code "0")
      math(EXPR _next "${_index} + ${_width}")
    elseif("${_pair}" STREQUAL "R\"" AND
        ("${_identifier}" STREQUAL "" OR "${_identifier}" MATCHES "^(u8|u|U|L)$"))
      # Maximal munch matters: identifierR"(...)" starts an ordinary string, NOT raw.
      math(EXPR _begin "${_index} + 2")
      string(SUBSTRING "${_contents}" ${_begin} -1 _rest)
      string(FIND "${_rest}" "(" _open)
      if(_open LESS 0 OR _open GREATER 16)
        message(FATAL_ERROR "ProcessScanner unsupported raw delimiter: ${_file}:${_number}:")
      endif()
      string(SUBSTRING "${_rest}" 0 ${_open} _delimiter)
      if("${_delimiter}" MATCHES "[ ()\\\\\t\n]")
        message(FATAL_ERROR "ProcessScanner unsupported raw delimiter: ${_file}:${_number}:")
      endif()
      set(_raw_end ")${_delimiter}\"")
      string(LENGTH "${_raw_end}" _raw_length)
      math(EXPR _width "${_open} + 2")
      string(SUBSTRING "${_contents}" ${_next} ${_width} _suffix)
      string(APPEND _line "${_suffix}")
      string(APPEND _code "@")
      math(EXPR _next "${_begin} + ${_open} + 1")
      set(_state raw)
      set(_literal_line ${_number})
    elseif("${_char}" STREQUAL "\\")
      # Do not guess token boundaries for escaped identifiers/extensions.
      message(FATAL_ERROR "ProcessScanner unsupported escape outside literal: ${_file}:${_number}:")
    elseif("${_char}" STREQUAL "\"" OR "${_char}" STREQUAL "'")
      set(_state quoted)
      set(_quote "${_char}")
      set(_literal_line ${_number})
      string(APPEND _code "@")
    else()
      if(("${_char}" STREQUAL "#" OR "${_pair}" STREQUAL "%:") AND
          "${_code}" MATCHES "^[ \t]*$")
        if(_block_on_line)
          message(FATAL_ERROR "ProcessScanner comment-adjacent directive: ${_file}:${_number}:")
        endif()
        set(_directive TRUE)
      endif()
      if("${_char}" STREQUAL "${_vertical_tab}" OR "${_char}" STREQUAL "${_form_feed}")
        string(APPEND _code " ")
        set(_identifier "")
      else()
        string(APPEND _code "${_char}")
      endif()
      # Keep non-ASCII identifier bytes opaque too; never misread a suffix R as raw.
      if("${_char}" STREQUAL "${_vertical_tab}" OR "${_char}" STREQUAL "${_form_feed}")
        set(_identifier "")
      elseif("${_char}" MATCHES "^[A-Za-z0-9_$]$" OR NOT "${_char}" MATCHES "^[ -~\t]$")
        string(APPEND _identifier "${_char}")
      else()
        set(_identifier "")
      endif()
    endif()
    set(_index ${_next})
  endwhile()
  if(_state STREQUAL "block" OR _state STREQUAL "raw" OR _state STREQUAL "quoted")
    message(FATAL_ERROR "ProcessScanner unterminated ${_state}: ${_file}:${_literal_line}:")
  endif()
  process_finish_scan_line()
endfunction()
